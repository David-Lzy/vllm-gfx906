diff --git a/src/policies/least_inflight.rs b/src/policies/least_inflight.rs
new file mode 100644
index 0000000..3676b99
--- /dev/null
+++ b/src/policies/least_inflight.rs
@@ -0,0 +1,116 @@
+//! Least-inflight load balancing policy.
+
+use super::{get_healthy_worker_indices, LoadBalancingPolicy, RequestHeaders};
+use crate::core::Worker;
+use crate::metrics::RouterMetrics;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Arc;
+
+/// Selects the healthy worker with the fewest requests currently tracked by
+/// the router. Equal-load workers are rotated to avoid a fixed-index bias.
+#[derive(Debug, Default)]
+pub struct LeastInflightPolicy {
+    counter: AtomicUsize,
+}
+
+impl LeastInflightPolicy {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    fn select_least_loaded(
+        &self,
+        workers: &[Arc<dyn Worker>],
+        healthy_indices: &[usize],
+    ) -> Option<usize> {
+        if healthy_indices.is_empty() {
+            return None;
+        }
+
+        let min_load = healthy_indices
+            .iter()
+            .map(|&idx| workers[idx].load())
+            .min()?;
+        let tied: Vec<usize> = healthy_indices
+            .iter()
+            .copied()
+            .filter(|&idx| workers[idx].load() == min_load)
+            .collect();
+        let turn = self.counter.fetch_add(1, Ordering::Relaxed);
+        Some(tied[turn % tied.len()])
+    }
+}
+
+impl LoadBalancingPolicy for LeastInflightPolicy {
+    fn select_worker_with_headers(
+        &self,
+        workers: &[Arc<dyn Worker>],
+        _request_text: Option<&str>,
+        _headers: Option<&RequestHeaders>,
+    ) -> Option<usize> {
+        let healthy_indices = get_healthy_worker_indices(workers);
+        let selected = self.select_least_loaded(workers, &healthy_indices)?;
+        let worker = workers[selected].url();
+
+        RouterMetrics::record_processed_request(worker);
+        RouterMetrics::record_policy_decision(self.name(), worker);
+        RouterMetrics::record_queue_policy_choice(self.name(), worker, "least_inflight");
+        Some(selected)
+    }
+
+    fn name(&self) -> &'static str {
+        "least_inflight"
+    }
+
+    fn reset(&self) {
+        self.counter.store(0, Ordering::Relaxed);
+    }
+
+    fn as_any(&self) -> &dyn std::any::Any {
+        self
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::core::{BasicWorker, WorkerType};
+
+    fn workers() -> Vec<Arc<dyn Worker>> {
+        vec![
+            Arc::new(BasicWorker::new(
+                "http://w0:8000".to_string(),
+                WorkerType::Regular,
+            )),
+            Arc::new(BasicWorker::new(
+                "http://w1:8000".to_string(),
+                WorkerType::Regular,
+            )),
+            Arc::new(BasicWorker::new(
+                "http://w2:8000".to_string(),
+                WorkerType::Regular,
+            )),
+        ]
+    }
+
+    #[test]
+    fn selects_lowest_local_inflight() {
+        let policy = LeastInflightPolicy::new();
+        let workers = workers();
+        workers[0].increment_load();
+        workers[0].increment_load();
+        workers[1].increment_load();
+
+        assert_eq!(policy.select_worker(&workers, None), Some(2));
+    }
+
+    #[test]
+    fn rotates_equal_load_workers() {
+        let policy = LeastInflightPolicy::new();
+        let workers = workers();
+
+        assert_eq!(policy.select_worker(&workers, None), Some(0));
+        assert_eq!(policy.select_worker(&workers, None), Some(1));
+        assert_eq!(policy.select_worker(&workers, None), Some(2));
+    }
+}
