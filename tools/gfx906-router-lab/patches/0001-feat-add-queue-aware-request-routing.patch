@@ -0,0 +1,461 @@
+//! Queue-aware load balancing policy for independent vLLM workers.
+
+use super::{get_healthy_worker_indices, LoadBalancingPolicy, RequestHeaders};
+use crate::core::Worker;
+use crate::metrics::RouterMetrics;
+use futures::future::join_all;
+use parking_lot::RwLock;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+use tracing::{debug, warn};
+
+#[derive(Debug, Clone, Copy)]
+pub struct QueueAwareConfig {
+    pub metrics_interval_ms: u64,
+    pub metrics_timeout_ms: u64,
+    pub metrics_stale_ms: u64,
+}
+
+impl Default for QueueAwareConfig {
+    fn default() -> Self {
+        Self {
+            metrics_interval_ms: 500,
+            metrics_timeout_ms: 200,
+            metrics_stale_ms: 2_000,
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+struct QueueTelemetry {
+    running: usize,
+    waiting: usize,
+    updated_at: Instant,
+}
+
+/// Selects the worker with the smallest observed queue and effective depth.
+///
+/// If any worker telemetry is missing or stale, selection falls back to local
+/// in-flight counts. If no telemetry has ever been observed, it falls back to
+/// round-robin. This prevents an unreachable metrics endpoint from looking
+/// artificially idle.
+#[derive(Debug)]
+pub struct QueueAwarePolicy {
+    config: QueueAwareConfig,
+    counter: AtomicUsize,
+    telemetry: Arc<RwLock<HashMap<String, QueueTelemetry>>>,
+    worker_urls: Arc<RwLock<Vec<String>>>,
+    monitor_started: AtomicBool,
+}
+
+impl QueueAwarePolicy {
+    pub fn new() -> Self {
+        Self::with_config(QueueAwareConfig::default())
+    }
+
+    pub fn with_config(config: QueueAwareConfig) -> Self {
+        Self {
+            config,
+            counter: AtomicUsize::new(0),
+            telemetry: Arc::new(RwLock::new(HashMap::new())),
+            worker_urls: Arc::new(RwLock::new(Vec::new())),
+            monitor_started: AtomicBool::new(false),
+        }
+    }
+
+    fn rotated_pick(&self, candidates: &[usize]) -> Option<usize> {
+        if candidates.is_empty() {
+            return None;
+        }
+        let turn = self.counter.fetch_add(1, Ordering::Relaxed);
+        Some(candidates[turn % candidates.len()])
+    }
+
+    fn select_round_robin(&self, healthy_indices: &[usize]) -> Option<usize> {
+        self.rotated_pick(healthy_indices)
+    }
+
+    fn select_least_inflight(
+        &self,
+        workers: &[Arc<dyn Worker>],
+        healthy_indices: &[usize],
+    ) -> Option<usize> {
+        let min_load = healthy_indices
+            .iter()
+            .map(|&idx| workers[idx].load())
+            .min()?;
+        let candidates: Vec<usize> = healthy_indices
+            .iter()
+            .copied()
+            .filter(|&idx| workers[idx].load() == min_load)
+            .collect();
+        self.rotated_pick(&candidates)
+    }
+
+    fn select_from_fresh_telemetry(
+        &self,
+        workers: &[Arc<dyn Worker>],
+        healthy_indices: &[usize],
+        telemetry: &HashMap<String, QueueTelemetry>,
+        now: Instant,
+    ) -> Option<usize> {
+        let stale_after = Duration::from_millis(self.config.metrics_stale_ms);
+        let mut scores = Vec::with_capacity(healthy_indices.len());
+
+        for &idx in healthy_indices {
+            let snapshot = telemetry.get(workers[idx].url())?;
+            if now.saturating_duration_since(snapshot.updated_at) > stale_after {
+                return None;
+            }
+            let effective_depth = (snapshot.running + snapshot.waiting).max(workers[idx].load());
+            scores.push((idx, snapshot.waiting, effective_depth));
+        }
+
+        let best = scores
+            .iter()
+            .map(|(_, waiting, depth)| (*waiting, *depth))
+            .min()?;
+        let candidates: Vec<usize> = scores
+            .into_iter()
+            .filter_map(|(idx, waiting, depth)| ((waiting, depth) == best).then_some(idx))
+            .collect();
+        self.rotated_pick(&candidates)
+    }
+
+    fn start_monitor(&self) {
+        let Ok(runtime) = tokio::runtime::Handle::try_current() else {
+            warn!("queue-aware metrics monitor requires a Tokio runtime");
+            return;
+        };
+        if self
+            .monitor_started
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return;
+        }
+
+        let config = self.config;
+        let telemetry = Arc::clone(&self.telemetry);
+        let worker_urls = Arc::clone(&self.worker_urls);
+        runtime.spawn(async move {
+            monitor_worker_queues(config, worker_urls, telemetry).await;
+        });
+    }
+
+    #[cfg(test)]
+    fn set_telemetry(&self, worker_url: &str, running: usize, waiting: usize, age: Duration) {
+        self.telemetry.write().insert(
+            worker_url.to_string(),
+            QueueTelemetry {
+                running,
+                waiting,
+                updated_at: Instant::now() - age,
+            },
+        );
+    }
+}
+
+impl Default for QueueAwarePolicy {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl LoadBalancingPolicy for QueueAwarePolicy {
+    fn select_worker_with_headers(
+        &self,
+        workers: &[Arc<dyn Worker>],
+        _request_text: Option<&str>,
+        _headers: Option<&RequestHeaders>,
+    ) -> Option<usize> {
+        let healthy_indices = get_healthy_worker_indices(workers);
+        if healthy_indices.is_empty() {
+            return None;
+        }
+
+        let now = Instant::now();
+        let telemetry = self.telemetry.read();
+        for &idx in &healthy_indices {
+            let local_inflight = workers[idx].load();
+            RouterMetrics::set_local_inflight(workers[idx].url(), local_inflight);
+            if let Some(snapshot) = telemetry.get(workers[idx].url()) {
+                RouterMetrics::set_queue_telemetry_age(
+                    workers[idx].url(),
+                    now.saturating_duration_since(snapshot.updated_at)
+                        .as_secs_f64(),
+                );
+            }
+            let effective_depth = telemetry
+                .get(workers[idx].url())
+                .map(|snapshot| (snapshot.running + snapshot.waiting).max(local_inflight))
+                .unwrap_or(local_inflight);
+            RouterMetrics::set_queue_effective_depth(workers[idx].url(), effective_depth);
+        }
+        let fresh_count = healthy_indices
+            .iter()
+            .filter(|&&idx| {
+                telemetry.get(workers[idx].url()).is_some_and(|snapshot| {
+                    now.saturating_duration_since(snapshot.updated_at)
+                        <= Duration::from_millis(self.config.metrics_stale_ms)
+                })
+            })
+            .count();
+        let observed_count = healthy_indices
+            .iter()
+            .filter(|&&idx| telemetry.contains_key(workers[idx].url()))
+            .count();
+
+        let (selected, reason) = if fresh_count == healthy_indices.len() {
+            (
+                self.select_from_fresh_telemetry(workers, &healthy_indices, &telemetry, now)?,
+                "queue_aware",
+            )
+        } else if observed_count > 0 {
+            RouterMetrics::record_queue_fallback("least_inflight_stale_telemetry");
+            (
+                self.select_least_inflight(workers, &healthy_indices)?,
+                "least_inflight_stale_telemetry",
+            )
+        } else {
+            RouterMetrics::record_queue_fallback("round_robin_no_telemetry");
+            (
+                self.select_round_robin(&healthy_indices)?,
+                "round_robin_no_telemetry",
+            )
+        };
+        drop(telemetry);
+
+        let worker = workers[selected].url();
+        RouterMetrics::record_processed_request(worker);
+        RouterMetrics::record_policy_decision(self.name(), worker);
+        RouterMetrics::record_queue_policy_choice(self.name(), worker, reason);
+        Some(selected)
+    }
+
+    fn name(&self) -> &'static str {
+        "queue_aware"
+    }
+
+    fn reset(&self) {
+        self.counter.store(0, Ordering::Relaxed);
+        self.telemetry.write().clear();
+    }
+
+    fn as_any(&self) -> &dyn std::any::Any {
+        self
+    }
+
+    fn requires_initialization(&self) -> bool {
+        true
+    }
+
+    fn init_workers(&self, workers: &[Arc<dyn Worker>]) {
+        let mut urls: Vec<String> = workers
+            .iter()
+            .map(|worker| worker.url().to_string())
+            .collect();
+        urls.sort();
+        urls.dedup();
+        *self.worker_urls.write() = urls;
+        self.start_monitor();
+    }
+}
+
+async fn monitor_worker_queues(
+    config: QueueAwareConfig,
+    worker_urls: Arc<RwLock<Vec<String>>>,
+    telemetry: Arc<RwLock<HashMap<String, QueueTelemetry>>>,
+) {
+    let client = match reqwest::Client::builder()
+        .timeout(Duration::from_millis(config.metrics_timeout_ms))
+        .build()
+    {
+        Ok(client) => client,
+        Err(error) => {
+            warn!("failed to build queue-aware metrics client: {error}");
+            return;
+        }
+    };
+    let mut interval = tokio::time::interval(Duration::from_millis(config.metrics_interval_ms));
+    interval.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+
+    loop {
+        interval.tick().await;
+        let urls = worker_urls.read().clone();
+        let samples = join_all(urls.iter().cloned().map(|url| {
+            let client = client.clone();
+            async move {
+                let result = fetch_queue_depth(&client, &url).await;
+                (url, result)
+            }
+        }))
+        .await;
+
+        let now = Instant::now();
+        for (url, result) in samples {
+            match result {
+                Ok((running, waiting)) => {
+                    telemetry.write().insert(
+                        url.clone(),
+                        QueueTelemetry {
+                            running,
+                            waiting,
+                            updated_at: now,
+                        },
+                    );
+                    RouterMetrics::set_queue_observed(&url, running, waiting);
+                    RouterMetrics::set_queue_telemetry_age(&url, 0.0);
+                }
+                Err(error) => {
+                    debug!(worker = %url, %error, "queue metrics poll failed");
+                    if let Some(snapshot) = telemetry.read().get(&url) {
+                        RouterMetrics::set_queue_telemetry_age(
+                            &url,
+                            now.saturating_duration_since(snapshot.updated_at)
+                                .as_secs_f64(),
+                        );
+                    }
+                }
+            }
+        }
+    }
+}
+
+async fn fetch_queue_depth(
+    client: &reqwest::Client,
+    worker_url: &str,
+) -> Result<(usize, usize), String> {
+    let url = format!("{}/metrics", worker_url.trim_end_matches('/'));
+    let response = client
+        .get(&url)
+        .send()
+        .await
+        .map_err(|error| error.to_string())?
+        .error_for_status()
+        .map_err(|error| error.to_string())?;
+    let body = response.text().await.map_err(|error| error.to_string())?;
+    parse_queue_depth(&body).ok_or_else(|| "running/waiting metrics missing".to_string())
+}
+
+fn parse_queue_depth(body: &str) -> Option<(usize, usize)> {
+    let running = parse_metric_sum(
+        body,
+        &["vllm:num_requests_running", "vllm_num_requests_running"],
+    )?;
+    let waiting = parse_metric_sum(
+        body,
+        &["vllm:num_requests_waiting", "vllm_num_requests_waiting"],
+    )?;
+    Some((running, waiting))
+}
+
+fn parse_metric_sum(body: &str, names: &[&str]) -> Option<usize> {
+    let mut found = false;
+    let mut total = 0.0f64;
+    for line in body.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let Some(name) = names.iter().find(|name| {
+            line.starts_with(**name)
+                && line
+                    .as_bytes()
+                    .get(name.len())
+                    .is_some_and(|next| *next == b'{' || next.is_ascii_whitespace())
+        }) else {
+            continue;
+        };
+        let _ = name;
+        if let Some(value) = line
+            .split_whitespace()
+            .last()
+            .and_then(|value| value.parse::<f64>().ok())
+        {
+            found = true;
+            total += value.max(0.0);
+        }
+    }
+    found.then_some(total.round() as usize)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::core::{BasicWorker, WorkerType};
+
+    fn workers() -> Vec<Arc<dyn Worker>> {
+        (0..3)
+            .map(|idx| {
+                Arc::new(BasicWorker::new(
+                    format!("http://w{idx}:8000"),
+                    WorkerType::Regular,
+                )) as Arc<dyn Worker>
+            })
+            .collect()
+    }
+
+    #[test]
+    fn parses_colon_and_sanitized_prometheus_metrics() {
+        let body = r#"
+# HELP vllm:num_requests_running Number running
+vllm:num_requests_running{model_name="x"} 3.0
+vllm:num_requests_waiting{model_name="x"} 2.0
+"#;
+        assert_eq!(parse_queue_depth(body), Some((3, 2)));
+
+        let sanitized = "vllm_num_requests_running 4\nvllm_num_requests_waiting 1\n";
+        assert_eq!(parse_queue_depth(sanitized), Some((4, 1)));
+    }
+
+    #[test]
+    fn prefers_zero_waiting_before_effective_depth() {
+        let policy = QueueAwarePolicy::new();
+        let workers = workers();
+        policy.set_telemetry(workers[0].url(), 1, 1, Duration::ZERO);
+        policy.set_telemetry(workers[1].url(), 7, 0, Duration::ZERO);
+        policy.set_telemetry(workers[2].url(), 3, 0, Duration::ZERO);
+
+        assert_eq!(policy.select_worker(&workers, None), Some(2));
+    }
+
+    #[test]
+    fn stale_partial_telemetry_falls_back_to_least_inflight() {
+        let policy = QueueAwarePolicy::new();
+        let workers = workers();
+        workers[0].increment_load();
+        workers[1].increment_load();
+        workers[1].increment_load();
+        policy.set_telemetry(workers[0].url(), 0, 0, Duration::ZERO);
+        policy.set_telemetry(workers[1].url(), 0, 0, Duration::from_secs(5));
+        policy.set_telemetry(workers[2].url(), 0, 0, Duration::ZERO);
+
+        assert_eq!(policy.select_worker(&workers, None), Some(2));
+    }
+
+    #[test]
+    fn no_telemetry_uses_round_robin() {
+        let policy = QueueAwarePolicy::new();
+        let workers = workers();
+
+        assert_eq!(policy.select_worker(&workers, None), Some(0));
+        assert_eq!(policy.select_worker(&workers, None), Some(1));
+    }
+
+    #[test]
+    fn all_stale_telemetry_falls_back_to_least_inflight() {
+        let policy = QueueAwarePolicy::new();
+        let workers = workers();
+        workers[0].increment_load();
+        workers[0].increment_load();
+        workers[1].increment_load();
+        for worker in &workers {
+            policy.set_telemetry(worker.url(), 0, 0, Duration::from_secs(5));
+        }
+
+        assert_eq!(policy.select_worker(&workers, None), Some(2));
+    }
+}
