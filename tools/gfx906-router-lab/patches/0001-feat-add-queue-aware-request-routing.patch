+/// Owns one router-local in-flight reservation. Dropping the guard releases
+/// the reservation exactly once, including cancellation and streaming paths.
+struct InflightGuard {
+    worker: Arc<dyn Worker>,
+    route: String,
+    started_at: Instant,
+}
+
+impl InflightGuard {
+    fn new(worker: Arc<dyn Worker>, route: &str) -> Self {
+        worker.increment_load();
+        RouterMetrics::set_running_requests(worker.url(), worker.load());
+        RouterMetrics::set_local_inflight(worker.url(), worker.load());
+        Self {
+            worker,
+            route: route.to_string(),
+            started_at: Instant::now(),
+        }
+    }
+}
+
+impl Drop for InflightGuard {
+    fn drop(&mut self) {
+        self.worker.decrement_load();
+        RouterMetrics::set_running_requests(self.worker.url(), self.worker.load());
+        RouterMetrics::set_local_inflight(self.worker.url(), self.worker.load());
+        RouterMetrics::record_worker_request_duration(
+            self.worker.url(),
+            &self.route,
+            self.started_at.elapsed(),
+        );
+    }
+}
+
+/// Couples a backend byte stream to its in-flight reservation. Axum drops the
+/// response body when the client disconnects, which drops this wrapper and
+/// releases the reservation immediately instead of waiting for another
+/// backend chunk.
+struct GuardedResponseStream {
+    inner: Pin<Box<dyn Stream<Item = Result<bytes::Bytes, reqwest::Error>> + Send>>,
+    _guard: InflightGuard,
+}
+
+impl Stream for GuardedResponseStream {
+    type Item = Result<bytes::Bytes, std::io::Error>;
+
+    fn poll_next(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        match self.inner.as_mut().poll_next(cx) {
+            Poll::Ready(Some(Ok(bytes))) => Poll::Ready(Some(Ok(bytes))),
+            Poll::Ready(Some(Err(error))) => Poll::Ready(Some(Err(std::io::Error::other(
+                format!("Stream error: {error}"),
+            )))),
+            Poll::Ready(None) => Poll::Ready(None),
+            Poll::Pending => Poll::Pending,
+        }
+    }
+}
