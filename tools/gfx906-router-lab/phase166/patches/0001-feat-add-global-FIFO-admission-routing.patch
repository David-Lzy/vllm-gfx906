+//! Strict FIFO admission control for fixed-capacity worker pools.
+
+use crate::core::{Worker, WorkerRegistry};
+use crate::metrics::RouterMetrics;
+use std::collections::{HashMap, VecDeque};
+use std::fmt;
+use std::sync::{Arc, Mutex, Weak};
+use std::time::{Duration, Instant};
+use tokio::sync::oneshot;
+
+pub const DEFAULT_MODEL_KEY: &str = "__default__";
+
+#[derive(Debug, Clone, Copy)]
+pub struct GlobalFifoConfig {
+    pub worker_capacity: usize,
+    pub max_waiting: usize,
+    pub max_queued_bytes: usize,
+    pub queue_timeout: Duration,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum AdmissionError {
+    QueueFull,
+    QueueBytesFull,
+    QueueTimeout,
+    RequestSerialization(String),
+    DispatcherClosed,
+}
+
+impl fmt::Display for AdmissionError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::QueueFull => write!(f, "router admission queue is full"),
+            Self::QueueBytesFull => write!(f, "router admission byte limit is full"),
+            Self::QueueTimeout => write!(f, "request timed out in the router admission queue"),
+            Self::RequestSerialization(error) => {
+                write!(f, "failed to size queued request: {error}")
+            }
+            Self::DispatcherClosed => write!(f, "router admission dispatcher closed"),
+        }
+    }
+}
+
+pub struct AdmissionAssignment {
+    pub worker: Arc<dyn Worker>,
+    pub lease: AdmissionLease,
+    pub ticket_id: u64,
+    pub waited: Duration,
+}
+
+impl fmt::Debug for AdmissionAssignment {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("AdmissionAssignment")
+            .field("worker", &self.worker.url())
+            .field("ticket_id", &self.ticket_id)
+            .field("waited", &self.waited)
+            .finish_non_exhaustive()
+    }
+}
+
+pub struct AdmissionLease {
+    inner: Weak<AdmissionInner>,
+    worker: Arc<dyn Worker>,
+    model: String,
+    route: String,
+    started_at: Instant,
+    active: bool,
+}
+
+impl fmt::Debug for AdmissionLease {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("AdmissionLease")
+            .field("worker", &self.worker.url())
+            .field("model", &self.model)
+            .field("route", &self.route)
+            .field("active", &self.active)
+            .finish()
+    }
+}
+
+impl Drop for AdmissionLease {
+    fn drop(&mut self) {
+        if !self.active {
+            return;
+        }
+        self.active = false;
+        if let Some(inner) = self.inner.upgrade() {
+            inner.release(
+                &self.model,
+                self.worker.clone(),
+                &self.route,
+                self.started_at,
+            );
+        }
+    }
+}
+
+struct Waiter {
+    ticket_id: u64,
+    enqueued_at: Instant,
+    body_bytes: usize,
+    route: String,
+    excluded_worker: Option<String>,
+    tx: oneshot::Sender<Result<AdmissionAssignment, AdmissionError>>,
+}
+
+#[derive(Default)]
+struct ModelQueue {
+    waiters: VecDeque<Waiter>,
+    rr_cursor: usize,
+}
+
+#[derive(Default)]
+struct AdmissionState {
+    active_by_worker: HashMap<String, usize>,
+    queues: HashMap<String, ModelQueue>,
+    model_order: Vec<String>,
+    model_cursor: usize,
+    next_ticket: u64,
+    queued_count: usize,
+    queued_bytes: usize,
+}
+
+struct Delivery {
+    tx: oneshot::Sender<Result<AdmissionAssignment, AdmissionError>>,
+    result: Result<AdmissionAssignment, AdmissionError>,
+}
+
+struct AdmissionInner {
+    config: GlobalFifoConfig,
+    worker_registry: Arc<WorkerRegistry>,
+    state: Mutex<AdmissionState>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AdmissionSnapshot {
+    pub active_by_worker: HashMap<String, usize>,
+    pub queued_by_model: HashMap<String, usize>,
+    pub queued_count: usize,
+    pub queued_bytes: usize,
+}
+
+#[derive(Clone)]
+pub struct GlobalFifoAdmission {
+    inner: Arc<AdmissionInner>,
+}
+
+impl fmt::Debug for GlobalFifoAdmission {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("GlobalFifoAdmission")
+            .field("config", &self.inner.config)
+            .finish_non_exhaustive()
+    }
+}
+
+impl GlobalFifoAdmission {
+    pub fn new(config: GlobalFifoConfig, worker_registry: Arc<WorkerRegistry>) -> Self {
+        assert!(
+            config.worker_capacity > 0,
+            "worker capacity must be positive"
+        );
+        assert!(config.max_waiting > 0, "queue size must be positive");
+        assert!(
+            config.max_queued_bytes > 0,
+            "queue byte limit must be positive"
+        );
+        assert!(
+            !config.queue_timeout.is_zero(),
+            "queue timeout must be positive"
+        );
+
+        // Static workers begin healthy, but the upstream health gauge is only
+        // updated on a transition. Seed every worker here so admission and
+        // health observability are complete from the first scrape.
+        for worker in worker_registry.get_all() {
+            RouterMetrics::set_worker_health(worker.url(), worker.is_available());
+            RouterMetrics::set_admission_worker_slots(worker.url(), 0);
+        }
+
+        Self {
+            inner: Arc::new(AdmissionInner {
+                config,
+                worker_registry,
+                state: Mutex::new(AdmissionState::default()),
+            }),
+        }
+    }
+
+    /// Periodically wakes queues after worker health recovery and keeps age
+    /// gauges current. Worker metrics are never used as scheduling input.
+    pub fn start_housekeeping(&self) {
+        let inner = Arc::downgrade(&self.inner);
+        tokio::spawn(async move {
+            let mut interval = tokio::time::interval(Duration::from_millis(250));
+            loop {
+                interval.tick().await;
+                let Some(inner) = inner.upgrade() else {
+                    break;
+                };
+                inner.expire_waiters();
+                inner.drive();
+                inner.refresh_metrics();
+            }
+        });
+    }
+
+    pub async fn acquire<T: serde::Serialize>(
+        &self,
+        model: &str,
+        route: &str,
+        content_length: Option<usize>,
+        request: &T,
+        excluded_worker: Option<&str>,
+    ) -> Result<AdmissionAssignment, AdmissionError> {
+        let model = normalize_model(model);
+
+        if let Some(assignment) = self
+            .inner
+            .try_acquire_immediate(&model, route, excluded_worker)
+        {
+            return Ok(assignment);
+        }
+
+        // Avoid a second JSON serialization on the normal fast path. Only a
+        // request that must wait and lacks Content-Length pays this cost.
+        let body_bytes = match content_length {
+            Some(size) => size,
+            None => serde_json::to_vec(request)
+                .map_err(|error| AdmissionError::RequestSerialization(error.to_string()))?
+                .len(),
+        };
+
+        self.inner
+            .enqueue_and_wait(&model, route, body_bytes, excluded_worker)
+            .await
+    }
+
+    pub fn snapshot(&self) -> AdmissionSnapshot {
+        self.inner.snapshot()
+    }
+}
+
+fn normalize_model(model: &str) -> String {
+    if model.trim().is_empty() || model == "unknown" {
+        DEFAULT_MODEL_KEY.to_string()
+    } else {
+        model.to_string()
+    }
+}
+
+impl AdmissionInner {
+    fn try_acquire_immediate(
+        self: &Arc<Self>,
+        model: &str,
+        route: &str,
+        excluded_worker: Option<&str>,
+    ) -> Option<AdmissionAssignment> {
+        let dispatch_started = Instant::now();
+        let mut state = self.state.lock().expect("admission state poisoned");
+        let queue_has_waiters = state
+            .queues
+            .get(model)
+            .is_some_and(|queue| !queue.waiters.is_empty());
+        if queue_has_waiters {
+            return None;
+        }
+
+        let worker = self.select_worker_locked(&mut state, model, excluded_worker)?;
+        let ticket_id = Self::next_ticket_locked(&mut state);
+        let assignment =
+            self.reserve_locked(&mut state, model, route, ticket_id, Duration::ZERO, worker);
+        self.update_metrics_locked(&state);
+        RouterMetrics::record_dispatch_duration("global_fifo", dispatch_started.elapsed());
+        Some(assignment)
+    }
+
+    async fn enqueue_and_wait(
+        self: &Arc<Self>,
+        model: &str,
+        route: &str,
+        body_bytes: usize,
+        excluded_worker: Option<&str>,
+    ) -> Result<AdmissionAssignment, AdmissionError> {
+        let (tx, mut rx) = oneshot::channel();
+        let ticket_id;
+        {
+            let mut state = self.state.lock().expect("admission state poisoned");
+            if state.queued_count >= self.config.max_waiting {
+                RouterMetrics::record_admission_rejection(model, "request_limit");
+                return Err(AdmissionError::QueueFull);
+            }
+            if state
+                .queued_bytes
+                .checked_add(body_bytes)
+                .is_none_or(|total| total > self.config.max_queued_bytes)
+            {
+                RouterMetrics::record_admission_rejection(model, "byte_limit");
+                return Err(AdmissionError::QueueBytesFull);
+            }
+
+            ticket_id = Self::next_ticket_locked(&mut state);
+            if !state.queues.contains_key(model) {
+                state.model_order.push(model.to_string());
+            }
+            state
+                .queues
+                .entry(model.to_string())
+                .or_default()
+                .waiters
+                .push_back(Waiter {
+                    ticket_id,
+                    enqueued_at: Instant::now(),
+                    body_bytes,
+                    route: route.to_string(),
+                    excluded_worker: excluded_worker.map(ToOwned::to_owned),
+                    tx,
+                });
+            state.queued_count += 1;
+            state.queued_bytes += body_bytes;
+            self.update_metrics_locked(&state);
+        }
+
+        let mut cancellation = QueueCancellation {
+            inner: Arc::downgrade(self),
+            model: model.to_string(),
+            ticket_id,
+            active: true,
+        };
+
+        self.drive();
+
+        let result = match tokio::time::timeout(self.config.queue_timeout, &mut rx).await {
+            Ok(Ok(result)) => result,
+            Ok(Err(_)) => Err(AdmissionError::DispatcherClosed),
+            Err(_) => {
+                RouterMetrics::record_admission_timeout(model);
+                Err(AdmissionError::QueueTimeout)
+            }
+        };
+        cancellation.active = false;
+        if matches!(result, Err(AdmissionError::QueueTimeout)) {
+            self.cancel_waiter(model, ticket_id, "timeout");
+        }
+        result
+    }
+
+    fn next_ticket_locked(state: &mut AdmissionState) -> u64 {
+        let ticket = state.next_ticket;
+        state.next_ticket = state.next_ticket.wrapping_add(1);
+        ticket
+    }
+
+    fn workers_for_model(&self, model: &str) -> Vec<Arc<dyn Worker>> {
+        if model != DEFAULT_MODEL_KEY {
+            let model_workers = self.worker_registry.get_by_model_fast(model);
+            if !model_workers.is_empty() {
+                return model_workers;
+            }
+        }
+
+        let all = self.worker_registry.get_all();
+        if model == DEFAULT_MODEL_KEY || all.iter().all(|worker| worker.model_id() == "unknown") {
+            all
+        } else {
+            Vec::new()
+        }
+    }
+
+    fn select_worker_locked(
+        &self,
+        state: &mut AdmissionState,
+        model: &str,
+        excluded_worker: Option<&str>,
+    ) -> Option<Arc<dyn Worker>> {
+        let mut eligible: Vec<Arc<dyn Worker>> = self
+            .workers_for_model(model)
+            .into_iter()
+            .filter(|worker| worker.is_available())
+            .filter(|worker| {
+                state
+                    .active_by_worker
+                    .get(worker.url())
+                    .copied()
+                    .unwrap_or(0)
+                    < self.config.worker_capacity
+            })
+            .collect();
+
+        if eligible.is_empty() {
+            return None;
+        }
+
+        if let Some(excluded) = excluded_worker {
+            if eligible.iter().any(|worker| worker.url() != excluded) {
+                eligible.retain(|worker| worker.url() != excluded);
+            }
+        }
+
+        let minimum = eligible
+            .iter()
+            .map(|worker| {
+                state
+                    .active_by_worker
+                    .get(worker.url())
+                    .copied()
+                    .unwrap_or(0)
+            })
+            .min()?;
+        eligible.retain(|worker| {
+            state
+                .active_by_worker
+                .get(worker.url())
+                .copied()
+                .unwrap_or(0)
+                == minimum
+        });
+        eligible.sort_by(|left, right| left.url().cmp(right.url()));
+
+        if !state.queues.contains_key(model) {
+            state.model_order.push(model.to_string());
+        }
+        let queue = state.queues.entry(model.to_string()).or_default();
+        let index = queue.rr_cursor % eligible.len();
+        queue.rr_cursor = queue.rr_cursor.wrapping_add(1);
+        Some(eligible[index].clone())
+    }
+
+    fn reserve_locked(
+        self: &Arc<Self>,
+        state: &mut AdmissionState,
+        model: &str,
+        route: &str,
+        ticket_id: u64,
+        waited: Duration,
+        worker: Arc<dyn Worker>,
+    ) -> AdmissionAssignment {
+        let active = state
+            .active_by_worker
+            .entry(worker.url().to_string())
+            .or_insert(0);
+        *active += 1;
+        if *active > self.config.worker_capacity {
+            RouterMetrics::record_admission_invariant_violation("worker_capacity");
+        }
+
+        worker.increment_load();
+        RouterMetrics::set_running_requests(worker.url(), worker.load());
+        RouterMetrics::set_admission_worker_slots(worker.url(), *active);
+        RouterMetrics::record_admission_dispatch(model, worker.url());
+        RouterMetrics::record_processed_request(worker.url());
+        RouterMetrics::record_policy_decision("global_fifo", worker.url());
+        RouterMetrics::record_admission_wait(model, waited);
+
+        AdmissionAssignment {
+            worker: worker.clone(),
+            lease: AdmissionLease {
+                inner: Arc::downgrade(self),
+                worker,
+                model: model.to_string(),
+                route: route.to_string(),
+                started_at: Instant::now(),
+                active: true,
+            },
+            ticket_id,
+            waited,
+        }
+    }
+
+    fn drive(self: &Arc<Self>) {
+        loop {
+            let deliveries = {
+                let mut state = self.state.lock().expect("admission state poisoned");
+                let deliveries = self.plan_dispatches_locked(&mut state);
+                self.update_metrics_locked(&state);
+                deliveries
+            };
+
+            if deliveries.is_empty() {
+                break;
+            }
+
+            for delivery in deliveries {
+                if let Err(result) = delivery.tx.send(delivery.result) {
+                    // Dropping a successfully reserved assignment releases its
+                    // lease and wakes the next FIFO waiter.
+                    drop(result);
+                }
+            }
+        }
+    }
+
+    fn plan_dispatches_locked(self: &Arc<Self>, state: &mut AdmissionState) -> Vec<Delivery> {
+        let mut deliveries = Vec::new();
+
+        loop {
+            if state.model_order.is_empty() {
+                break;
+            }
+            let order_len = state.model_order.len();
+            let mut progressed = false;
+
+            for offset in 0..order_len {
+                let index = (state.model_cursor + offset) % order_len;
+                let model = state.model_order[index].clone();
+
+                while state
+                    .queues
+                    .get(&model)
+                    .and_then(|queue| queue.waiters.front())
+                    .is_some_and(|waiter| waiter.tx.is_closed())
+                {
+                    if let Some(waiter) = self.pop_front_locked(state, &model) {
+                        RouterMetrics::record_admission_cancellation(&model, "receiver_closed");
+                        drop(waiter);
+                        progressed = true;
+                    }
+                }
+
+                let Some((excluded, route, ticket_id, enqueued_at)) = state
+                    .queues
+                    .get(&model)
+                    .and_then(|queue| queue.waiters.front())
+                    .map(|waiter| {
+                        (
+                            waiter.excluded_worker.clone(),
+                            waiter.route.clone(),
+                            waiter.ticket_id,
+                            waiter.enqueued_at,
+                        )
+                    })
+                else {
+                    continue;
+                };
+
+                let dispatch_started = Instant::now();
+                let Some(worker) = self.select_worker_locked(state, &model, excluded.as_deref())
+                else {
+                    continue;
+                };
+
+                let waiter = self
+                    .pop_front_locked(state, &model)
+                    .expect("FIFO front disappeared while dispatching");
+                let waited = enqueued_at.elapsed();
+                let assignment =
+                    self.reserve_locked(state, &model, &route, ticket_id, waited, worker);
+                RouterMetrics::record_dispatch_duration("global_fifo", dispatch_started.elapsed());
+                deliveries.push(Delivery {
+                    tx: waiter.tx,
+                    result: Ok(assignment),
+                });
+                state.model_cursor = (index + 1) % order_len;
+                progressed = true;
+            }
+
+            if !progressed {
+                break;
+            }
+        }
+
+        deliveries
+    }
+
+    fn pop_front_locked(&self, state: &mut AdmissionState, model: &str) -> Option<Waiter> {
+        let waiter = state.queues.get_mut(model)?.waiters.pop_front()?;
+        state.queued_count = state.queued_count.saturating_sub(1);
+        state.queued_bytes = state.queued_bytes.saturating_sub(waiter.body_bytes);
+        Some(waiter)
+    }
+
+    fn release(
+        self: &Arc<Self>,
+        _model: &str,
+        worker: Arc<dyn Worker>,
+        route: &str,
+        started_at: Instant,
+    ) {
+        {
+            let mut state = self.state.lock().expect("admission state poisoned");
+            let active = state
+                .active_by_worker
+                .entry(worker.url().to_string())
+                .or_insert(0);
+            if *active == 0 {
+                RouterMetrics::record_admission_invariant_violation("double_release");
+            } else {
+                *active -= 1;
+            }
+            worker.decrement_load();
+            RouterMetrics::set_running_requests(worker.url(), worker.load());
+            RouterMetrics::set_admission_worker_slots(worker.url(), *active);
+            RouterMetrics::record_worker_request_duration(
+                worker.url(),
+                route,
+                started_at.elapsed(),
+            );
+            self.update_metrics_locked(&state);
+        }
+        self.drive();
+    }
+
+    fn cancel_waiter(self: &Arc<Self>, model: &str, ticket_id: u64, reason: &str) {
+        let removed = {
+            let mut state = self.state.lock().expect("admission state poisoned");
+            let position = state.queues.get(model).and_then(|queue| {
+                queue
+                    .waiters
+                    .iter()
+                    .position(|waiter| waiter.ticket_id == ticket_id)
+            });
+            let removed = position.and_then(|position| {
+                let waiter = state
+                    .queues
+                    .get_mut(model)
+                    .and_then(|queue| queue.waiters.remove(position));
+                if let Some(waiter) = &waiter {
+                    state.queued_count = state.queued_count.saturating_sub(1);
+                    state.queued_bytes = state.queued_bytes.saturating_sub(waiter.body_bytes);
+                }
+                waiter
+            });
+            self.update_metrics_locked(&state);
+            removed
+        };
+        if removed.is_some() {
+            RouterMetrics::record_admission_cancellation(model, reason);
+            self.drive();
+        }
+    }
+
+    fn expire_waiters(self: &Arc<Self>) {
+        let mut deliveries = Vec::new();
+        {
+            let mut state = self.state.lock().expect("admission state poisoned");
+            let models = state.model_order.clone();
+            for model in models {
+                loop {
+                    let expired = state
+                        .queues
+                        .get(&model)
+                        .and_then(|queue| queue.waiters.front())
+                        .is_some_and(|waiter| {
+                            waiter.enqueued_at.elapsed() >= self.config.queue_timeout
+                        });
+                    if !expired {
+                        break;
+                    }
+                    if let Some(waiter) = self.pop_front_locked(&mut state, &model) {
+                        RouterMetrics::record_admission_timeout(&model);
+                        deliveries.push(Delivery {
+                            tx: waiter.tx,
+                            result: Err(AdmissionError::QueueTimeout),
+                        });
+                    }
+                }
+            }
+            self.update_metrics_locked(&state);
+        }
+        for delivery in deliveries {
+            let _ = delivery.tx.send(delivery.result);
+        }
+    }
+
+    fn refresh_metrics(&self) {
+        let state = self.state.lock().expect("admission state poisoned");
+        self.update_metrics_locked(&state);
+    }
+
+    fn update_metrics_locked(&self, state: &AdmissionState) {
+        RouterMetrics::set_admission_queue_depth_total(state.queued_count);
+        RouterMetrics::set_admission_queue_bytes_total(state.queued_bytes);
+        for model in &state.model_order {
+            let queue = state.queues.get(model);
+            let depth = queue.map_or(0, |queue| queue.waiters.len());
+            let bytes = queue.map_or(0, |queue| {
+                queue.waiters.iter().map(|waiter| waiter.body_bytes).sum()
+            });
+            let oldest = queue
+                .and_then(|queue| queue.waiters.front())
+                .map_or(Duration::ZERO, |waiter| waiter.enqueued_at.elapsed());
+            RouterMetrics::set_admission_queue_depth(model, depth);
+            RouterMetrics::set_admission_queue_bytes(model, bytes);
+            RouterMetrics::set_admission_oldest_wait(model, oldest);
+        }
+    }
+
+    fn snapshot(&self) -> AdmissionSnapshot {
+        let state = self.state.lock().expect("admission state poisoned");
+        AdmissionSnapshot {
+            active_by_worker: state.active_by_worker.clone(),
+            queued_by_model: state
+                .queues
+                .iter()
+                .map(|(model, queue)| (model.clone(), queue.waiters.len()))
+                .collect(),
+            queued_count: state.queued_count,
+            queued_bytes: state.queued_bytes,
+        }
+    }
+}
+
+struct QueueCancellation {
+    inner: Weak<AdmissionInner>,
+    model: String,
+    ticket_id: u64,
+    active: bool,
+}
+
+impl Drop for QueueCancellation {
+    fn drop(&mut self) {
+        if !self.active {
+            return;
+        }
+        if let Some(inner) = self.inner.upgrade() {
+            inner.cancel_waiter(&self.model, self.ticket_id, "client_cancelled");
+        }
+    }
+}
