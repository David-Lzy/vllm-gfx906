@@ -0,0 +1,51 @@
+//! Non-generation fallback selector for the global FIFO Router mode.
+//!
+//! Generation routes are dispatched by `GlobalFifoAdmission`. Other typed
+//! routes retain deterministic round-robin behavior through this policy.
+
+use super::{get_healthy_worker_indices, LoadBalancingPolicy, RequestHeaders};
+use crate::core::Worker;
+use crate::metrics::RouterMetrics;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Arc;
+
+#[derive(Debug, Default)]
+pub struct GlobalFifoPolicy {
+    counter: AtomicUsize,
+}
+
+impl GlobalFifoPolicy {
+    pub fn new() -> Self {
+        Self::default()
+    }
+}
+
+impl LoadBalancingPolicy for GlobalFifoPolicy {
+    fn select_worker_with_headers(
+        &self,
+        workers: &[Arc<dyn Worker>],
+        _request_text: Option<&str>,
+        _headers: Option<&RequestHeaders>,
+    ) -> Option<usize> {
+        let healthy = get_healthy_worker_indices(workers);
+        if healthy.is_empty() {
+            return None;
+        }
+        let index = healthy[self.counter.fetch_add(1, Ordering::Relaxed) % healthy.len()];
+        RouterMetrics::record_processed_request(workers[index].url());
+        RouterMetrics::record_policy_decision(self.name(), workers[index].url());
+        Some(index)
+    }
+
+    fn name(&self) -> &'static str {
+        "global_fifo"
+    }
+
+    fn reset(&self) {
+        self.counter.store(0, Ordering::Relaxed);
+    }
+
+    fn as_any(&self) -> &dyn std::any::Any {
+        self
+    }
+}
