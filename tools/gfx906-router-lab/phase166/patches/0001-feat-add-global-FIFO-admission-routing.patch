+    async fn send_transparent_with_lease(
+        &self,
+        headers: Option<&HeaderMap>,
+        path: &str,
+        method: &Method,
+        body: &serde_json::Value,
+        worker: Arc<dyn Worker>,
+        lease: RequestLease,
+    ) -> Response {
+        let url = worker.endpoint_url(path);
+        let mut request_builder = match *method {
+            Method::GET => self.client.get(&url),
+            Method::POST => self.client.post(&url),
+            Method::PUT => self.client.put(&url),
+            Method::DELETE => self.client.delete(&url),
+            Method::PATCH => self.client.patch(&url),
+            Method::HEAD => self.client.head(&url),
+            _ => {
+                return (
+                    StatusCode::METHOD_NOT_ALLOWED,
+                    format!("Method {method} not supported"),
+                )
+                    .into_response();
+            }
+        };
+        request_builder = dp_utils::add_dp_rank_header(request_builder, worker.dp_rank());
+        if !body.is_null() {
+            request_builder = request_builder.json(body);
+        }
+        if let Some(ref key) = self.api_key {
+            request_builder = request_builder.header("Authorization", format!("Bearer {key}"));
+        }
+
+        let backend = match otel_http::send_client_request(
+            request_builder,
+            headers,
+            ClientRequestOptions {
+                method: method.as_str(),
+                url: &url,
+                route: Some(path),
+                request_phase: Some("inference"),
+            },
+        )
+        .await
+        {
+            Ok(response) => response,
+            Err(error) => {
+                return (
+                    StatusCode::BAD_GATEWAY,
+                    format!("Backend request failed: {error}"),
+                )
+                    .into_response();
+            }
+        };
+
+        let status = backend.status();
+        let backend_headers = backend.headers().clone();
+        let stream = GuardedResponseStream {
+            inner: Box::pin(backend.bytes_stream()),
+            _lease: lease,
+        };
+        let mut builder = Response::builder().status(status.as_u16());
+        for (name, value) in &backend_headers {
+            if name != "transfer-encoding" && name != "content-length" {
+                builder = builder.header(name, value);
+            }
         }
+        builder
+            .body(Body::from_stream(stream))
+            .unwrap_or_else(|error| {
+                (
+                    StatusCode::INTERNAL_SERVER_ERROR,
+                    format!("Failed to build response: {error}"),
+                )
+                    .into_response()
+            })
     }
 
