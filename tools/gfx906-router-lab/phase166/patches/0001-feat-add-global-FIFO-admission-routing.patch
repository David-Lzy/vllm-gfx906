+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::core::{BasicWorker, WorkerType};
+    use serde_json::json;
+
+    fn fixture(worker_count: usize, capacity: usize, max_waiting: usize) -> GlobalFifoAdmission {
+        let registry = Arc::new(WorkerRegistry::new());
+        for index in 0..worker_count {
+            registry.register(Arc::new(BasicWorker::new(
+                format!("http://worker-{index}:8000"),
+                WorkerType::Regular,
+            )));
+        }
+        GlobalFifoAdmission::new(
+            GlobalFifoConfig {
+                worker_capacity: capacity,
+                max_waiting,
+                max_queued_bytes: 1024,
+                queue_timeout: Duration::from_secs(1),
+            },
+            registry,
+        )
+    }
+
+    #[tokio::test]
+    async fn reserves_synchronously_and_never_exceeds_worker_capacity() {
+        let admission = fixture(4, 2, 8);
+        let request = json!({"prompt": "test"});
+        let mut assignments = Vec::new();
+        for _ in 0..8 {
+            assignments.push(
+                admission
+                    .acquire("model", "/generate", Some(10), &request, None)
+                    .await
+                    .unwrap(),
+            );
+        }
+        let snapshot = admission.snapshot();
+        assert_eq!(snapshot.active_by_worker.len(), 4);
+        assert!(snapshot
+            .active_by_worker
+            .values()
+            .all(|active| *active == 2));
+        assert_eq!(snapshot.queued_count, 0);
+        drop(assignments);
+        assert!(admission
+            .snapshot()
+            .active_by_worker
+            .values()
+            .all(|active| *active == 0));
+    }
+
+    #[tokio::test]
+    async fn preserves_fifo_when_a_slot_is_released() {
+        let admission = fixture(1, 1, 4);
+        let request = json!({"prompt": "test"});
+        let first = admission
+            .acquire("model", "/generate", Some(10), &request, None)
+            .await
+            .unwrap();
+
+        let second_task = {
+            let admission = admission.clone();
+            let request = request.clone();
+            tokio::spawn(async move {
+                admission
+                    .acquire("model", "/generate", Some(10), &request, None)
+                    .await
+                    .unwrap()
+            })
+        };
+        tokio::task::yield_now().await;
+        let third_task = {
+            let admission = admission.clone();
+            let request = request.clone();
+            tokio::spawn(async move {
+                admission
+                    .acquire("model", "/generate", Some(10), &request, None)
+                    .await
+                    .unwrap()
+            })
+        };
+        tokio::time::sleep(Duration::from_millis(10)).await;
+        assert_eq!(admission.snapshot().queued_count, 2);
+        drop(first);
+        let second = second_task.await.unwrap();
+        assert!(!third_task.is_finished());
+        drop(second);
+        let third = third_task.await.unwrap();
+        assert!(third.ticket_id > 0);
+    }
+
+    #[tokio::test]
+    async fn cancelled_waiter_releases_queue_bytes() {
+        let admission = fixture(1, 1, 4);
+        let request = json!({"prompt": "test"});
+        let first = admission
+            .acquire("model", "/generate", Some(10), &request, None)
+            .await
+            .unwrap();
+        let task = {
+            let admission = admission.clone();
+            let request = request.clone();
+            tokio::spawn(async move {
+                admission
+                    .acquire("model", "/generate", Some(37), &request, None)
+                    .await
+            })
+        };
+        tokio::time::sleep(Duration::from_millis(10)).await;
+        assert_eq!(admission.snapshot().queued_bytes, 37);
+        task.abort();
+        let _ = task.await;
+        tokio::time::sleep(Duration::from_millis(10)).await;
+        assert_eq!(admission.snapshot().queued_bytes, 0);
+        drop(first);
+    }
+
+    #[tokio::test]
+    async fn retry_excludes_failed_worker_when_an_alternative_exists() {
+        let admission = fixture(2, 1, 4);
+        let request = json!({"prompt": "test"});
+        let first = admission
+            .acquire("model", "/generate", Some(10), &request, None)
+            .await
+            .unwrap();
+        let failed_url = first.worker.url().to_string();
+        drop(first);
+        let retry = admission
+            .acquire("model", "/generate", Some(10), &request, Some(&failed_url))
+            .await
+            .unwrap();
+        assert_ne!(retry.worker.url(), failed_url);
+    }
+
+    #[tokio::test]
+    async fn enforces_request_and_byte_queue_limits() {
+        let admission = fixture(1, 1, 1);
+        let request = json!({"prompt": "test"});
+        let first = admission
+            .acquire("model", "/generate", Some(10), &request, None)
+            .await
+            .unwrap();
+        let queued = {
+            let admission = admission.clone();
+            let request = request.clone();
+            tokio::spawn(async move {
+                admission
+                    .acquire("model", "/generate", Some(10), &request, None)
+                    .await
+            })
+        };
+        tokio::time::sleep(Duration::from_millis(10)).await;
+        assert!(matches!(
+            admission
+                .acquire("model", "/generate", Some(10), &request, None)
+                .await,
+            Err(AdmissionError::QueueFull)
+        ));
+        queued.abort();
+        let _ = queued.await;
+        drop(first);
+
+        let byte_limited = GlobalFifoAdmission::new(
+            GlobalFifoConfig {
+                worker_capacity: 1,
+                max_waiting: 2,
+                max_queued_bytes: 5,
+                queue_timeout: Duration::from_secs(1),
+            },
+            admission.inner.worker_registry.clone(),
+        );
+        let active = byte_limited
+            .acquire("model", "/generate", Some(1), &request, None)
+            .await
+            .unwrap();
+        assert!(matches!(
+            byte_limited
+                .acquire("model", "/generate", Some(6), &request, None)
+                .await,
+            Err(AdmissionError::QueueBytesFull)
+        ));
+        drop(active);
+    }
+
+    #[tokio::test]
+    async fn burst_128_never_dispatches_more_than_32() {
+        let admission = fixture(4, 8, 96);
+        let request = json!({"prompt": "burst"});
+        let mut active = Vec::new();
+        for _ in 0..32 {
+            active.push(
+                admission
+                    .acquire("model", "/generate", Some(8), &request, None)
+                    .await
+                    .unwrap(),
+            );
+        }
+
+        let mut queued = Vec::new();
+        for _ in 0..96 {
+            let admission = admission.clone();
+            let request = request.clone();
+            queued.push(tokio::spawn(async move {
+                let assignment = admission
+                    .acquire("model", "/generate", Some(8), &request, None)
+                    .await
+                    .unwrap();
+                drop(assignment);
+            }));
+        }
+        for _ in 0..100 {
+            if admission.snapshot().queued_count == 96 {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(2)).await;
+        }
+
+        let snapshot = admission.snapshot();
+        assert_eq!(snapshot.queued_count, 96);
+        assert_eq!(snapshot.active_by_worker.values().sum::<usize>(), 32);
+        assert!(snapshot
+            .active_by_worker
+            .values()
+            .all(|active| *active <= 8));
+        assert!(matches!(
+            admission
+                .acquire("model", "/generate", Some(8), &request, None)
+                .await,
+            Err(AdmissionError::QueueFull)
+        ));
+
+        drop(active);
+        for task in queued {
+            tokio::time::timeout(Duration::from_secs(2), task)
+                .await
+                .expect("queued burst stalled")
+                .unwrap();
+        }
+        let drained = admission.snapshot();
+        assert_eq!(drained.queued_count, 0);
+        assert!(drained.active_by_worker.values().all(|active| *active == 0));
+    }
+
+    #[tokio::test]
+    async fn queue_timeout_removes_waiter_and_bytes() {
+        let registry = Arc::new(WorkerRegistry::new());
+        registry.register(Arc::new(BasicWorker::new(
+            "http://worker:8000".to_string(),
+            WorkerType::Regular,
+        )));
+        let admission = GlobalFifoAdmission::new(
+            GlobalFifoConfig {
+                worker_capacity: 1,
+                max_waiting: 2,
+                max_queued_bytes: 1024,
+                queue_timeout: Duration::from_millis(25),
+            },
+            registry,
+        );
+        let request = json!({"prompt": "timeout"});
+        let active = admission
+            .acquire("model", "/generate", Some(8), &request, None)
+            .await
+            .unwrap();
+        assert!(matches!(
+            admission
+                .acquire("model", "/generate", Some(91), &request, None)
+                .await,
+            Err(AdmissionError::QueueTimeout)
+        ));
+        let snapshot = admission.snapshot();
+        assert_eq!(snapshot.queued_count, 0);
+        assert_eq!(snapshot.queued_bytes, 0);
+        drop(active);
+    }
+
+    #[tokio::test]
+    async fn health_loss_and_recovery_change_only_future_dispatches() {
+        let admission = fixture(2, 1, 4);
+        let request = json!({"prompt": "health"});
+        let first = admission
+            .acquire("model", "/generate", Some(8), &request, None)
+            .await
+            .unwrap();
+        let second = admission
+            .acquire("model", "/generate", Some(8), &request, None)
+            .await
+            .unwrap();
+        let failed_worker = first.worker.clone();
+        failed_worker.set_healthy(false);
+
+        let waiting = {
+            let admission = admission.clone();
+            let request = request.clone();
+            tokio::spawn(async move {
+                admission
+                    .acquire("model", "/generate", Some(8), &request, None)
+                    .await
+                    .unwrap()
+            })
+        };
+        tokio::time::sleep(Duration::from_millis(5)).await;
+        drop(first);
+        drop(second);
+        let assignment = tokio::time::timeout(Duration::from_secs(1), waiting)
+            .await
+            .unwrap()
+            .unwrap();
+        assert_ne!(assignment.worker.url(), failed_worker.url());
+
+        let waiting_after_recovery = {
+            let admission = admission.clone();
+            let request = request.clone();
+            tokio::spawn(async move {
+                admission
+                    .acquire("model", "/generate", Some(8), &request, None)
+                    .await
+                    .unwrap()
+            })
+        };
+        tokio::time::sleep(Duration::from_millis(5)).await;
+        failed_worker.set_healthy(true);
+        admission.inner.drive();
+        let recovered = tokio::time::timeout(Duration::from_secs(1), waiting_after_recovery)
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(recovered.worker.url(), failed_worker.url());
+        drop(recovered);
+        drop(assignment);
+    }
+}
