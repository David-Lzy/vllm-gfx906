+/// Owns one router-local in-flight reservation for non-admission policies.
+/// Dropping the guard releases the reservation on every response path.
+struct InflightGuard {
+    worker: Arc<dyn Worker>,
+    route: String,
+    started_at: Instant,
+}
+
+impl InflightGuard {
+    fn new(worker: Arc<dyn Worker>, route: &str) -> Self {
+        worker.increment_load();
+        RouterMetrics::set_running_requests(worker.url(), worker.load());
+        Self {
+            worker,
+            route: route.to_string(),
+            started_at: Instant::now(),
+        }
+    }
+}
+
+impl Drop for InflightGuard {
+    fn drop(&mut self) {
+        self.worker.decrement_load();
+        RouterMetrics::set_running_requests(self.worker.url(), self.worker.load());
+        RouterMetrics::record_worker_request_duration(
+            self.worker.url(),
+            &self.route,
+            self.started_at.elapsed(),
+        );
+    }
+}
+
+enum RequestLease {
+    Inflight { _guard: InflightGuard },
+    Admission { _lease: AdmissionLease },
+}
+
+struct GuardedResponseStream {
+    inner: Pin<Box<dyn Stream<Item = Result<bytes::Bytes, reqwest::Error>> + Send>>,
+    _lease: RequestLease,
+}
+
+impl Stream for GuardedResponseStream {
+    type Item = Result<bytes::Bytes, std::io::Error>;
+
+    fn poll_next(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+        match self.inner.as_mut().poll_next(cx) {
+            Poll::Ready(Some(Ok(bytes))) => Poll::Ready(Some(Ok(bytes))),
+            Poll::Ready(Some(Err(error))) => Poll::Ready(Some(Err(std::io::Error::other(
+                format!("Stream error: {error}"),
+            )))),
+            Poll::Ready(None) => Poll::Ready(None),
+            Poll::Pending => Poll::Pending,
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+struct TerminalAdmissionResponse;
+
+fn is_generation_route(route: &str) -> bool {
+    matches!(
+        route,
+        "/generate"
+            | "/inference/v1/generate"
+            | "/v1/chat/completions"
+            | "/v1/completions"
+            | "/v1/responses"
+    )
+}
+
+fn content_length(headers: Option<&HeaderMap>) -> Option<usize> {
+    headers?
+        .get(CONTENT_LENGTH)?
+        .to_str()
+        .ok()?
+        .parse::<usize>()
+        .ok()
+}
+
+fn admission_error_response(error: AdmissionError) -> Response {
+    let (status, error_type, code) = match error {
+        AdmissionError::QueueFull => (
+            StatusCode::TOO_MANY_REQUESTS,
+            "rate_limit_error",
+            "router_admission_queue_full",
+        ),
+        AdmissionError::QueueBytesFull => (
+            StatusCode::TOO_MANY_REQUESTS,
+            "rate_limit_error",
+            "router_admission_bytes_full",
+        ),
+        AdmissionError::QueueTimeout => (
+            StatusCode::REQUEST_TIMEOUT,
+            "request_timeout_error",
+            "router_admission_timeout",
+        ),
+        AdmissionError::RequestSerialization(_) => (
+            StatusCode::BAD_REQUEST,
+            "invalid_request_error",
+            "router_admission_size_error",
+        ),
+        AdmissionError::DispatcherClosed => (
+            StatusCode::SERVICE_UNAVAILABLE,
+            "server_error",
+            "router_admission_unavailable",
+        ),
+    };
+    let message = error.to_string();
+    let mut response = (
+        status,
+        Json(serde_json::json!({
+            "error": {
+                "message": message,
+                "type": error_type,
+                "param": null,
+                "code": code,
+            }
+        })),
+    )
+        .into_response();
+    if status == StatusCode::TOO_MANY_REQUESTS {
+        response
+            .headers_mut()
+            .insert(RETRY_AFTER, HeaderValue::from_static("30"));
+    }
+    response.extensions_mut().insert(TerminalAdmissionResponse);
+    response
+}
