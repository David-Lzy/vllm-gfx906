# syntax=docker/dockerfile:1.7
#
# Phase 65 rebuilds only the stable extension from the validated legacy-QGEMM
# image, changing the guarded rows-per-block value from 8 to 4.
ARG BASE_IMAGE=local/vllm-gfx906:v0.27.1-phase44-legacy-qgemm
FROM ${BASE_IMAGE}

ARG VLLM_BUILD_VERSION=0.27.1+gfx906.phase65.legacyqgemmrow4
ARG VLLM_UPSTREAM_REV=a259296151

ENV VLLM_TARGET_DEVICE=rocm \
    PYTORCH_ROCM_ARCH=gfx906 \
    VLLM_ROCM_USE_AITER=0 \
    VLLM_USE_PRECOMPILED=0 \
    VLLM_USE_PRECOMPILED_RUST=0 \
    CMAKE_BUILD_TYPE=Release \
    MAX_JOBS=12 \
    SETUPTOOLS_SCM_PRETEND_VERSION=${VLLM_BUILD_VERSION} \
    CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    PATH=/opt/vllm-venv/bin:/root/.cargo/bin:/opt/rocm/llvm/bin:/opt/rocm/bin:${PATH} \
    VIRTUAL_ENV=/opt/vllm-venv \
    ROCBLAS_TENSILE_LIBPATH=/opt/rocm/lib/rocblas/library

LABEL org.opencontainers.image.source="https://github.com/David-Lzy/vllm-gfx906" \
      org.opencontainers.image.revision="${VLLM_UPSTREAM_REV}" \
      org.opencontainers.image.description="Phase 65 gfx906 legacy QGEMM row-4 candidate; not production"

WORKDIR /workspace/vllm
COPY . /workspace/vllm

RUN --mount=type=cache,target=/root/.cache/ccache \
    --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/workspace/vllm/rust/target \
    export CCACHE_DIR=/root/.cache/ccache \
    && rm -f /opt/vllm-wheel/vllm-*.whl \
    && CMAKE_ARGS='-DVLLM_GFX906_LEGACY_QGEMM=ON -DVLLM_GFX906_LEGACY_QGEMM_ROWS_PER_BLOCK=4' \
        VLLM_REQUIRE_RUST_FRONTEND=1 /opt/vllm-venv/bin/python setup.py bdist_wheel \
          --dist-dir /opt/vllm-wheel \
    && uv pip install --python /opt/vllm-venv/bin/python --no-deps --force-reinstall \
        /opt/vllm-wheel/*.whl

RUN /opt/vllm-venv/bin/python -c 'import torch, vllm; assert torch.version.hip is not None; print(f"vllm={vllm.__version__}"); print(f"torch={torch.__version__}"); print(f"hip={torch.version.hip}")'

WORKDIR /workspace
ENTRYPOINT ["/opt/vllm-venv/bin/vllm"]
CMD ["--help"]
